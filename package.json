{
  "name": "curso.dev",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/joaogabriel1309/curso.dev#readme",
  "bugs": {
    "url": "https://github.com/joaogabriel1309/curso.dev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaogabriel1309/curso.dev.git"
  },
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "scripts": {
    "prod": "next dev",
    "dev": "npm run service:up && npm run service:wait:database && npm run migrations:up && next dev",
    "test": "npm run service:up && concurrently -n next,jest --hide next -k -s command-jest \"next dev\" \"jest --runInBand --verbose\"",
    "service:up": "docker compose -f infra/compose.yaml up -d",
    "service:down": "docker compose -f infra/compose.yaml down",
    "service:stop": "docker compose -f infra/compose.yaml stop",
    "service:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate create -m infra/migrations create ",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "test:watch": "jest --watchAll --runInBand",
    "lint:prettier:fix": "prettier --write .",
    "lint:prettier:check": "prettier --check .",
    "lint:eslint:check": "eslint .",
    "prepare": "husky",
    "commit": "cz"
  },
  "dependencies": {
    "async-retry": "^1.3.3",
    "dotenv": "^16.4.4",
    "dotenv-expand": "^11.0.6",
    "next": "^16.4.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "commitizen": "^4.3.0",
    "concurrently": "^10.0.6",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "husky": "^9.1.4",
    "jest": "^30.5.2",
    "prettier": "^3.9.10"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
